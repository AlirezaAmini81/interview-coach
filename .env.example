# Copy to .env and fill in to run with --provider anthropic
ANTHROPIC_API_KEY=your-key-here

# Optional: enables LangSmith tracing for every mode-routing, fact-check,
# and evaluation call. Free account at smith.langchain.com.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=interview-coach
